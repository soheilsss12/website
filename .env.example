# Local development only. Copy to .env and enter deployment secrets outside source control.
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
DATA_DIR=server/data

# Leave both empty until an administrator chooses real credentials.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_SAMESITE=Lax

# One real team inbox and a verified Resend sender are required for email delivery.
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=

# Optional exact public frontend origin for cross-origin deployments.
# Same-origin deployment is recommended; do not put a URL path here.
PUBLIC_ORIGIN=
TRUST_PROXY=false

# Optional only when the API is hosted on a different origin.
# Prefer leaving empty when the Node server serves both the site and /api.
VITE_API_BASE_URL=
