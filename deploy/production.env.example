# Copy to .env.production on the server. Do not commit real values.
# DNS for this host must point at the server; TCP ports 80 and 443 must be reachable.
PUBLIC_DOMAIN=

# Choose your own admin username and a unique random password (16-256 characters).
# No account or password is supplied by the application.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12

# Optional: leave all three blank to store submissions without email notifications.
# To enable email, fill in all three with real Resend/domain values.
ADMIN_NOTIFICATION_EMAIL=
EMAIL_FROM=
RESEND_API_KEY=
